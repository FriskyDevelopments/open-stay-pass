# Open Stay Pass — example environment
#
# Copy to `.env` and fill in the values you actually need:
#   cp .env.example .env
#
# Nothing here is a real credential. `.env` is git-ignored; keep it that way.
# The zero-setup path (QR + arrival guide + local concierge fallback) runs with
# only the "Core" block below. Every other block is a progressive upgrade and
# stays cleanly disabled while its variables are empty.

# ---------------------------------------------------------------------------
# Core — required to run the server
# ---------------------------------------------------------------------------

# Node environment. `development` enables the dev-only debug collector.
NODE_ENV=development

# HTTP port for the Express server. Defaults to 3000 when unset.
PORT=3000

# Signing key for the operator session cookie (HS256 JWT).
# MUST be at least 32 characters — the server refuses to sign or verify
# sessions with a shorter key so a missing value can never be forged around.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# HMAC key for signed guest/handoff credential tokens.
# MUST be at least 32 characters. Rotating it revokes every issued QR link.
# Generate one with: openssl rand -base64 48
CREDENTIAL_HMAC_SECRET=

# MySQL/TiDB connection string used by Drizzle.
# Leave empty to run without a database: the app degrades to in-memory
# behaviour and logs a warning instead of crashing.
# Example shape: mysql://user:password@host:4000/open_stay_pass
DATABASE_URL=

# Comma-separated list of browser origins allowed to send credentialed
# requests. Defaults to the published Pages and Manus origins when unset.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Platform identity (Manus WebDev OAuth)
# ---------------------------------------------------------------------------

# Base URL of the Manus WebDev auth service used by the OAuth callback.
OAUTH_SERVER_URL=

# OAuth client id for this application. Also read on the client as VITE_APP_ID.
VITE_APP_ID=

# Hosted login portal the frontend redirects to when starting a login.
VITE_OAUTH_PORTAL_URL=

# openId of the account that should be promoted to `admin` on first sign-in.
OWNER_OPEN_ID=

# ---------------------------------------------------------------------------
# HostCasa shared login (Supabase) — optional
# Both values are public client configuration, never a service-role key.
# Leave both empty to disable the shared-login entry point; the SSO route then
# fails closed with HTTP 503 instead of half-working.
# ---------------------------------------------------------------------------

# Supabase project URL. Must be https://
VITE_HOSTCASA_SUPABASE_URL=

# Supabase publishable / anon key for the same project.
VITE_HOSTCASA_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Frontend wiring
# ---------------------------------------------------------------------------

# Origin of the Open Stay Pass API. Empty means same-origin, which is what a
# single-host deployment wants. Set it when the frontend is hosted separately
# (e.g. Cloudflare Pages calling the Manus backend).
VITE_OPEN_STAY_API_ORIGIN=

# Public repository URL. The Star call-to-action stays hidden until this is a
# verified https://github.com/... URL.
VITE_GITHUB_REPOSITORY_URL=

# Umami analytics. Both are substituted into client/index.html at build time.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Optional community-support links
# Each is domain-validated; an unrecognised host is dropped rather than shown.
# Leave empty to fall back to the maintainer's official destinations.
# ---------------------------------------------------------------------------

VITE_KOFI_URL=
VITE_NOWPAYMENTS_URL=
VITE_WISE_URL=

# ---------------------------------------------------------------------------
# Apple Wallet — optional
# Wallet actions stay hidden until a real Pass Type ID certificate can sign.
# ---------------------------------------------------------------------------

# Pass Type identifier, e.g. pass.works.folios.handoff
APPLE_PASS_TYPE_ID=

# Apple Developer Team identifier.
APPLE_TEAM_ID=

# Pass Type ID certificate exported as .p12 and base64-encoded.
# Never commit the raw .p12 or this value.
APPLE_CERTIFICATE_P12_BASE64=

# Passphrase for the .p12 bundle above.
APPLE_CERTIFICATE_PASSWORD=

# ---------------------------------------------------------------------------
# Google Wallet — optional
# The Add-to-Google-Wallet action stays hidden unless the service account can
# actually sign, so a malformed key degrades honestly instead of faking a demo.
# ---------------------------------------------------------------------------

# Google Wallet issuer id.
GOOGLE_WALLET_ISSUER_ID=

# Full, unmodified service-account JSON on a single line. Must contain a PKCS#8
# `private_key`. Never commit the real value.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Wallet pass updates — optional
# ---------------------------------------------------------------------------

# Public origin used to build pass and handoff URLs. Falls back to the first
# allowed CORS origin, then to the incoming request host.
FOLIOS_PUBLIC_ORIGIN=

# Base URL of the Wallet pass update web service (Apple `webServiceURL`).
WALLET_UPDATE_BASE_URL=

# Shared token Apple presents when calling the update web service.
WALLET_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Managed platform services (Manus Forge) — optional
# Back the AI concierge, image generation, maps proxy, storage and heartbeat.
# Without them the concierge falls back to the local grounded adapter.
# ---------------------------------------------------------------------------

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Browser-side equivalents, only needed when the client calls Forge directly.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Set to `true` to opt in to the live Wallet credential tests, which perform a
# real Apple signing check and a Google service-account authorization check.
# They are skipped by default and log no credential values.
RUN_WALLET_LIVE_CREDENTIAL_TESTS=false
