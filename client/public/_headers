# Cloudflare Pages response headers for the static frontend.
# The Express backend sets its own headers; these protect the Pages origin.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# Fingerprinted assets are immutable and safe to cache aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
